[gd_scene format=3]

[ext_resource type="Script" path="res://main/game/ui/day_transition.gd" id="1_trans"]
[ext_resource type="Script" path="res://scripts/mc_button.gd" id="2_btn"]

[node name="DayTransition" type="CanvasLayer"]
process_mode = 3
layer = 20
visible = false
script = ExtResource("1_trans")

[node name="Root" type="Control" parent="."]
texture_filter = 1
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Root"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.02, 0.08, 0.94)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Root/Center/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.9333, 0.9412, 1, 1)
theme_override_colors/font_outline_color = Color(0.0588, 0.1059, 0.1686, 1)
theme_override_constants/outline_size = 14
theme_override_font_sizes/font_size = 84
text = "You have survived!"
horizontal_alignment = 1

[node name="GapTop" type="Control" parent="Root/Center/Box"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2

[node name="PromptLabel" type="Label" parent="Root/Center/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0.1686, 0.1686, 0.1686, 1)
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 38
text = "Continue?"
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="Root/Center/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Continue"
script = ExtResource("2_btn")

[node name="GapBottom" type="Control" parent="Root/Center/Box"]
