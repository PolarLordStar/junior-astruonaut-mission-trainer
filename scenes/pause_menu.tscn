[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/PauseMenu.gd" id="1_pause"]
[ext_resource type="Script" path="res://scripts/mc_button.gd" id="2_btn"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 100
visible = false
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
texture_filter = 1
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.02, 0.08, 0.62)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Root/Center/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_outline_color = Color(0.1686, 0.1686, 0.1686, 1)
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 38
text = "Game Menu"
horizontal_alignment = 1

[node name="GapTop" type="Control" parent="Root/Center/Box"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

[node name="ContinueButton" type="Button" parent="Root/Center/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Continue"
script = ExtResource("2_btn")

[node name="RestartButton" type="Button" parent="Root/Center/Box"]
layout_mode = 2
text = "Restart"
script = ExtResource("2_btn")

[node name="OptionsButton" type="Button" parent="Root/Center/Box"]
layout_mode = 2
text = "Options"
script = ExtResource("2_btn")

[node name="GapBottom" type="Control" parent="Root/Center/Box"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2

[node name="MainMenuButton" type="Button" parent="Root/Center/Box"]
layout_mode = 2
text = "Return to Main Menu"
script = ExtResource("2_btn")

[node name="Toast" type="Label" parent="Root/Center/Box"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0)
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_colors/font_color = Color(1.0000, 1.0000, 0.6275, 1)
theme_override_colors/font_outline_color = Color(0.1686, 0.1686, 0.1686, 1)
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1

[connection signal="pressed" from="Root/Center/Box/ContinueButton" to="." method="close"]
[connection signal="pressed" from="Root/Center/Box/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Root/Center/Box/OptionsButton" to="." method="_on_options_button_pressed"]
[connection signal="pressed" from="Root/Center/Box/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
